# FootprintX API keys. Keep this file private — never share it or commit it.
#
# Native install: this file is ~/.config/footprintx/.env (created by install.sh).
# Docker / development: copy it to .env in the project folder.

# Shodan — optional. Paste your key after the = sign, no spaces:
#   SHODAN_API_KEY=abc123...
# Free account: https://account.shodan.io  (without a key the Shodan step is skipped)
SHODAN_API_KEY=

# Advanced: use a different settings file than the default
# (~/.config/footprintx/config.yaml, then ./config/config.yaml).
# FOOTPRINTX_CONFIG=/path/to/config.yaml
